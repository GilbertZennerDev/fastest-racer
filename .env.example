# Copy this file to .env and fill in real values, then redeploy.
# Without these, the app still runs — signup/login work, the Free tier
# works, but "Upgrade to Pro" will report billing as not configured.

# A long random string — used to sign session cookies. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET_KEY=

# From https://dashboard.stripe.com/apikeys (use the sk_test_... key while
# testing, sk_live_... only once you're ready to take real payments).
STRIPE_SECRET_KEY=

# The Price ID (not Product ID) of your Pro monthly plan, from
# https://dashboard.stripe.com/products — looks like price_1AbCdE...
STRIPE_PRICE_ID_PRO=

# From the webhook endpoint's settings after you create it at
# https://dashboard.stripe.com/webhooks pointing to
# https://<your-domain>/api/billing/webhook — looks like whsec_...
STRIPE_WEBHOOK_SECRET=

# The public URL this app is served at (used to build Stripe redirect URLs).
PUBLIC_BASE_URL=https://fastest-racer.workflowsolved.com
